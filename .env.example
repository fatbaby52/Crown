# Crown Consulting site + upload portal — environment variables.
# Copy to .env for `netlify dev`; set the same keys in Netlify UI for deploys.
# NEVER commit real values. Nothing in this file is a secret.

# ---- Existing site ----
OPENAI_API_KEY=

# ---- Portal switches ----
# off | staff_only | live   (kill switch: "off" stops everything; "staff_only"
# lets staff work while client links/codes/grants are refused)
PORTAL_MODE=staff_only
# staging | production  (only gates SCANNER_PROVIDER=staging-stub)
PORTAL_ENV=production
# Public origin of this deploy, used for invite links, CSRF origin checks and
# internal function calls, e.g. https://crownconsultingteam.com
PORTAL_SITE_URL=

# ---- Supabase (BidFuel project hosts the portal tables + bucket) ----
SUPABASE_URL=https://aaeudtfmjuuowvkexrfh.supabase.co
# Server-only. Project Settings -> API keys -> service_role (or a secret key).
SUPABASE_SERVICE_ROLE_KEY=
# Public key used by the staff console in the browser (sb_publishable_... or anon).
SUPABASE_PUBLISHABLE_KEY=
PORTAL_BUCKET=client-uploads

# ---- Secrets generated by you (openssl rand -base64 32) ----
# Pepper for hashing client IPs in rate-limit and session rows.
PORTAL_IP_PEPPER=
# Shared secret between public functions and the background scanner function.
PORTAL_INTERNAL_SECRET=

# ---- Email (Resend) ----
# resend | console   (console prints codes to the function log; refused when PORTAL_MODE=live)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Verified sender, e.g. "Crown Consulting <uploads@crownconsultingteam.com>"
PORTAL_FROM_EMAIL=
# Where upload receipts (reference + counts only) are sent.
PORTAL_RECEIPT_EMAIL=

# ---- Malware scanner ----
# none | clamav-rest | staging-stub | endpoint-only
# endpoint-only = Crown's decision (Nov 2026): no server-side scan, rely on
# staff endpoint antivirus; files are labelled "released, not scanned".
SCANNER_PROVIDER=endpoint-only
# Private ClamAV REST endpoint you host (e.g. https://clamav.internal.example)
SCANNER_URL=
SCANNER_TOKEN=

# ---- Limits (defaults shown) ----
PORTAL_MAX_FILE_BYTES=26214400
PORTAL_MAX_TOTAL_BYTES=262144000
PORTAL_ALLOWED_TYPES=pdf,jpg,png
PORTAL_DEFAULT_EXPIRY_DAYS=7
PORTAL_RETENTION_DAYS=90
PORTAL_ORPHAN_GRACE_HOURS=24
PORTAL_OTP_TTL_SECONDS=600
PORTAL_OTP_RESEND_COOLDOWN_SECONDS=60
PORTAL_OTP_MAX_ATTEMPTS=5
PORTAL_OTP_MAX_SENDS_PER_HOUR=6
PORTAL_OTP_MAX_SENDS_PER_IP_PER_HOUR=20
PORTAL_OTP_MAX_VERIFIES_PER_IP_PER_HOUR=40
PORTAL_SESSION_TTL_SECONDS=3600
PORTAL_GRANT_TTL_SECONDS=7200
PORTAL_DOWNLOAD_URL_SECONDS=60
